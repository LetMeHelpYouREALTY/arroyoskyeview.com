{
  // Repo-root pointer so Cloudflare “Import a repository” with default
  // root `.` deploys the hosted-images Worker instead of failing to find
  // wrangler config. One-click still uses workers/hosted-images/. Keep
  // this file in sync with workers/hosted-images/wrangler.jsonc.
  "name": "arroyoskyeview-hosted-images",
  "main": "workers/hosted-images/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "2cc579c1ec9e426ed585e933ebf4753b",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES",
    "remote": true
  },
  "vars": {
    "ORIGIN": "https://www.arroyoskyeview.com",
    "CREATOR": "arroyoskyeview.com"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
