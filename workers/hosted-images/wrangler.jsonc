{
  "name": "arroyoskyeview-hosted-images",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "2cc579c1ec9e426ed585e933ebf4753b",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES",
    "remote": true
  },
  "vars": {
    "ORIGIN": "https://www.arroyoskyeview.com",
    "CREATOR": "arroyoskyeview.com"
  },
  "triggers": {
    // Every 5 minutes so a laptop or Workers Builds deploy ingests without
    // waiting for the next hour or a /sync secret. After IDs exist,
    // ingestOne is a details() no-op.
    "crons": ["*/5 * * * *"]
  }
}
