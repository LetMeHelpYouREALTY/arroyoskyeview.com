{
  "name": "arroyoskyeview-hosted-images",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "2cc579c1ec9e426ed585e933ebf4753b",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "ORIGIN": "https://www.arroyoskyeview.com",
    "CREATOR": "arroyoskyeview.com"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
